# frozen_string_literal: true

RailsuiIcon.configure do |config|
<%% if File.exist?(Rails.root.join('config', 'initializers', 'railsui_icon.rb')) -%>
  # Existing installation detected - preserving backward compatibility

  # Keep your existing default_library setting (was likely :heroicons)
  # config.default_library = :heroicons

  # Keep your existing default_variant setting (was likely :outline)
  # config.default_variant = :outline

  # Your existing default_class configuration should continue to work
  # If you were using the flat structure, it's still supported:
  # config.default_class = {
  #   solid: "size-5 fill-current",
  #   outline: "size-5 stroke-current",
  #   mini: "size-3 fill-current",
  #   micro: "size-3 fill-current"
  # }

  # NEW: You can now optionally upgrade to the nested structure for multiple libraries:
  # config.default_class = {
  #   heroicons: {
  #     solid: "size-5 fill-current",
  #     outline: "size-5 stroke-current",
  #     mini: "size-3 fill-current",
  #     micro: "size-3 fill-current"
  #   },
  #   solar: {
  #     linear: "size-5 stroke-current",
  #     outline: "size-5 stroke-current",
  #     broken: "size-5 stroke-current",
  #     bold: "size-5 fill-current",
  #     bold_duotone: "size-5 fill-current",
  #     line_duotone: "size-5 stroke-current fill-current"
  #   },
  #    lucide: {
  #     lucide: "size-5 stroke-current"  # Use library name as variant for single icon collection libraries
  #   },
  #   feather: {
  #     feather: "size-5 stroke-current" # Use library name as variant for single icon collection libraries
  #   },
  #   boxicons: {
  #     outline: "size-5 stroke-current",
  #     solid: "size-5 fill-current"
  #   },
  #   phosphoric: {
  #     bold: "size-5 fill-current",
  #     duotone: "size-5 fill-current",
  #     fill: "size-5 fill-current",
  #     light: "size-5 stroke-current",
  #     regular: "size-5 stroke-current",
  #     thin: "size-5 stroke-current"
  #   }
  # }
<%% else -%>
  # Set the default icon library (:heroicons, :solar, :lucide, :feather)
  config.default_library = :heroicons

  # Set the default icon variant (:solid, :outline, :mini, :bold, :duotone, etc.)
  # Note: This is ignored for flat libraries like Lucide or Feather
  # View README (https://github.com/getrailsui/railsui_icon) for all available variants and options.

  config.default_variant = :outline

  # Optionally set default classes that apply to every icon with the given library/variant.
  # You can use either a nested structure (library -> variant) or flat structure (variant only)

  # Nested structure (recommended for multiple libraries):
  # config.default_class = {
  #   heroicons: {
  #     solid: "size-5 fill-current",
  #     outline: "size-5 stroke-current",
  #     mini: "size-3 fill-current",
  #     micro: "size-3 fill-current"
  #   },
  #   solar: {
  #     linear: "size-5 stroke-current",
  #     outline: "size-5 stroke-current",
  #     broken: "size-5 stroke-current",
  #     bold: "size-5 fill-current",
  #     bold_duotone: "size-5 fill-current",
  #     line_duotone: "size-5 stroke-current fill-current"
  #   },
  #    lucide: {
  #     lucide: "size-5 stroke-current"  # Use library name as variant for single icon collection libraries
  #   },
  #   feather: {
  #     feather: "size-5 stroke-current" # Use library name as variant for single icon collection libraries
  #   },
  #   boxicons: {
  #     outline: "size-5 stroke-current",
  #     solid: "size-5 fill-current"
  #   },
  #   phosphoric: {
  #     bold: "size-5 fill-current",
  #     duotone: "size-5 fill-current",
  #     fill: "size-5 fill-current",
  #     light: "size-5 stroke-current",
  #     regular: "size-5 stroke-current",
  #     thin: "size-5 stroke-current"
  #   }
  # }

  # Flat structure (for backward compatibility):
  # config.default_class = {
  #   solid: "size-5 fill-current",
  #   outline: "size-5 stroke-current",
  #   mini: "size-3 fill-current",
  #   micro: "size-3 fill-current"
  # }
<%% end -%>
end
